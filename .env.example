EXPOSE_API_PORT=3001
EXPOSE_WEB_APP_PORT=3000
EXPOSE_WEB_ADMIN_PORT=3002
EXPOSE_POSTGRES_PORT=5432
EXPOSE_REDIS_PORT=6379
DATABASE_NAME=poc
