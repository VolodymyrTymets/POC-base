  "scripts": {
    "build": "nest build",
    "worker:build": "nest build worker",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start api --watch",
    "worker:start:dev": "nest start worker --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/main",
    "worker:start:prod": "node dist/apps/worker",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "prisma-migrate": "npx prisma migrate dev",
    "prisma-gen": "npx prisma generate",
    "reset-db": "npx prisma migrate reset"
  },
