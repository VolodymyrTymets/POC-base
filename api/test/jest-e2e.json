{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/../jest.setup.js"],
  "moduleNameMapper": {
    "^generated/prisma/(.*)$": "<rootDir>/../generated/prisma/$1",
    "^generated/prisma$": "<rootDir>/../generated/prisma"
  }
}
